NEXT_PUBLIC_DASHBOARD_TIMEZONE=Europe/Paris

# --- Open-Meteo (optional "official" outdoor reading) ---
# When both are set, the status card shows a live outdoor temperature/humidity
# reading from Open-Meteo (free, no API key) next to your sensor's own
# reading, with the delta between them. Server-only (not NEXT_PUBLIC_) so the
# coordinates never reach the browser -- only the resulting numbers do.
# Rounded to 3 decimal places (~100m) is plenty; Open-Meteo's own model grid
# is much coarser than that.
# OPEN_METEO_LATITUDE=48.885
# OPEN_METEO_LONGITUDE=2.316

# --- Supabase (preferred data source) ---
# When both vars are set the dashboard reads from Supabase instead of Google Sheets.
# Run scripts/supabase-schema.sql in the Supabase SQL Editor first to create
# the `readings` table these vars point at.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Google Sheets (fallback / legacy) ---
# Used when Supabase vars are not set.
GOOGLE_SHEETS_ID=1PWeQyc0tR10fEe9v0JoBriOJLLUz-M5jYO3oxx_Z2gI

# Use this on Vercel, or locally if you do not have dashboard/credentials.json.
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-google-cloud-project-id","private_key_id":"replace-with-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-google-cloud-project-id.iam.gserviceaccount.com","client_id":"replace-with-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-google-cloud-project-id.iam.gserviceaccount.com","universe_domain":"googleapis.com"}'

# Alternative to GOOGLE_CREDENTIALS_JSON:
# GOOGLE_CLIENT_EMAIL=your-service-account@your-google-cloud-project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
